# ayarlicazhocam — environment variable template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# No secrets belong in this file — placeholders only.

# --- Model providers -------------------------------------------------------
# The default provider is local Ollama (no key required). Cloud provider keys
# are only needed if you set MODEL_PROVIDER=groq or =gemini.

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
# The Gemini SDK also honors GOOGLE_API_KEY; pick whichever your code reads.
GEMINI_API_KEY=

# --- Model selection -------------------------------------------------------
# Which provider the orchestrator should prefer: "ollama", "groq" or "gemini".
# "ollama" runs locally with no API key and no rate limits (install from
# https://ollama.com, then e.g. `ollama pull qwen2.5:7b`).
MODEL_PROVIDER=ollama

# Local Ollama model. qwen2.5:7b emits native tool calls reliably and is the
# recommended default. The fine-tuned identity model (ayarlicazhocam:latest)
# also works via the provider's text-tool-call fallback but is less reliable.
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434

# Cloud fallbacks (used only when MODEL_PROVIDER is groq/gemini).
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# --- Application -----------------------------------------------------------
# SQLite database path (created automatically on first run).
DATABASE_PATH=data/ayarlicazhocam.db
# Gradio server settings.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
