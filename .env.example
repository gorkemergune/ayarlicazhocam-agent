# ayarlicazhocam — environment variable template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# No secrets belong in this file — placeholders only.

# --- Model providers -------------------------------------------------------
# At least one provider key is required to run the agent.

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
# The Gemini SDK also honors GOOGLE_API_KEY; pick whichever your code reads.
GEMINI_API_KEY=

# --- Model selection (optional overrides) ----------------------------------
# Which provider the orchestrator should prefer: "groq" or "gemini".
MODEL_PROVIDER=groq
# Default model id per provider (leave blank to use code defaults).
GROQ_MODEL=
GEMINI_MODEL=

# --- Application -----------------------------------------------------------
# SQLite database path (created automatically on first run).
DATABASE_PATH=data/ayarlicazhocam.db
# Gradio server settings.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
